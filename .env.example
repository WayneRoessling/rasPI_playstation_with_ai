# Mini-AI Pi connection settings (read by pi_ssh.py and the setup scripts)
# Copy to .env and fill in values:  cp .env.example .env
# .env is gitignored — never commit your real host, user or password.

# Pi's IP address or mDNS hostname (e.g. mini-ai-01.local)
MINI_AI_HOST=192.168.1.50
# The username you created in Raspberry Pi Imager
MINI_AI_USER=pi
# Private key whose .pub you pasted into Imager's SSH settings
MINI_AI_SSH_KEY=~/.ssh/id_ed25519_mini_ai

# Only needed for password-based key push / re-push (delete after first use)
# MINI_AI_PASS=changeme
